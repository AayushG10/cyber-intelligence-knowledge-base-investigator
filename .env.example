# ---------------------------------------------------------------------------
# AI Cyber Investigation Platform — environment template
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# For a 48hr MVP the ONLY value you must obtain externally is OPENROUTER_API_KEY.
# Everything else you set yourself (local dbs, secrets).
# ---------------------------------------------------------------------------

# === LLM (OpenRouter — OpenAI-compatible gateway) =========================
# REQUIRED. Get from https://openrouter.ai/keys  (add ~$10 credit).
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model MUST support tool/function calling. Verify at https://openrouter.ai/models
# Primary recommendation; cheaper fallback: openai/gpt-4o-mini
LLM_MODEL=anthropic/claude-sonnet-4
# Optional OpenRouter ranking headers (safe to leave as-is or blank)
OPENROUTER_APP_TITLE=Cyber Investigation Platform
OPENROUTER_APP_URL=http://localhost:3000

# === Graph database (Neo4j) ================================================
# Aura (cloud): use the neo4j+s:// URI from your Aura console.
#   NOTE: on Aura the USER and DATABASE are 'neo4j' — NOT the instance id.
#   NOTE: Aura Free/AuraDB has NO GDS library -> run graph algos in NetworkX.
NEO4J_URI=neo4j+s://03050b8d.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_local_only
NEO4J_DATABASE=neo4j
# Self-hosted alternative (docker-compose, includes GDS+APOC):
# NEO4J_URI=bolt://localhost:7687

# === SQL database ==========================================================
# MVP: SQLite (a file, no server, nothing to sign up for).
DATABASE_URL=sqlite:///./app.db
# Production swap (uncomment to use Postgres from docker-compose):
# DATABASE_URL=postgresql+psycopg://postgres:change_me_local_only@localhost:5432/investigations

# === Auth ==================================================================
# Generate with:  openssl rand -hex 32
JWT_SECRET=replace_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=120

# === Optional (NOT needed for MVP) =========================================
# Only if you geolocate raw IPs instead of offline district geocoding.
# Free account at https://www.maxmind.com/en/geolite2/signup
# MAXMIND_LICENSE_KEY=

# === App config ============================================================
DATA_DIR=./data
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Map + geocoding use Leaflet/OpenStreetMap + offline district lookup: NO key needed.
